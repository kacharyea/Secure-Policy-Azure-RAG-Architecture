<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>SecurePolicyRag-Sample-Api</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="..\Data\policies.json" Link="Data\policies.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PolicyRag.Application\PolicyRag.Application.csproj" />
    <ProjectReference Include="..\PolicyRag.Infrastructure\PolicyRag.Infrastructure.csproj" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.0" />
  </ItemGroup>

</Project>
